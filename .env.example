# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HuggingFace (Kimi K2)
HF_TOKEN=

# Coral sources
PAGERDUTY_API_TOKEN=
DD_API_KEY=
DD_APPLICATION_KEY=
DD_SITE=datadoghq.com
GITHUB_TOKEN=
STATUSGATOR_API_TOKEN=

# Coral config directory — where Coral stores source registrations and secrets.
# Leave blank for local dev (uses ~/.config/coral by default).
# Set to a mounted path in Docker so credentials persist across container restarts.
# e.g. CORAL_CONFIG_DIR=/home/node/.coral
CORAL_CONFIG_DIR=

# PagerDuty webhook signature secret (required in production)
# PagerDuty → Integrations → Generic Webhooks (V3) → your webhook → Secret
PAGERDUTY_WEBHOOK_SECRET=

# Service → GitHub repo mapping (JSON array)
# Example: [{"pagerdutyService":"api","github":{"owner":"acme","repo":"api"}}]
SERVICE_MAP_JSON=

# API
PORT=3001
NODE_ENV=development

# Production CORS — set to your deployed web URL
WEB_ORIGIN=http://localhost:3000
