# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HuggingFace (Kimi K2)
HF_TOKEN=

# ── Coral ────────────────────────────────────────────────────────────────────
# CORAL_ENABLED: set false to run without Coral (returns empty data)
CORAL_ENABLED=true

# CORAL_BIN: override the coral binary path
#   Windows (WSL): CORAL_BIN=wsl -d Ubuntu -e coral
#   macOS/Linux:   leave blank (uses 'coral' on PATH)
CORAL_BIN=

# CORAL_CONFIG_DIR: where Coral stores source registrations
#   Windows (WSL): /home/YOUR_WSL_USERNAME/.config/coral
#   Docker:        /home/node/.coral  (mounted volume)
#   macOS/Linux:   leave blank (uses default)
CORAL_CONFIG_DIR=

# Coral source credentials
PAGERDUTY_API_TOKEN=
GRAFANA_URL=
GRAFANA_TOKEN=
GITHUB_TOKEN=
STATUSGATOR_API_TOKEN=

# PagerDuty webhook secret (optional, recommended in production)
PAGERDUTY_WEBHOOK_SECRET=

# Service → GitHub repo mapping
# Example: [{"pagerdutyService":"api","github":{"owner":"acme","repo":"api"}}]
SERVICE_MAP_JSON=

# API
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
